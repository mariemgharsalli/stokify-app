# Par défaut le front appelle http://127.0.0.1:5000/api (sans proxy Vite).
# Si le backend est sur un autre port :
# VITE_API_PORT=5001

# URL publique du front pour les QR (téléphone). Laissez vide pour détecter l’IP LAN.
# VITE_PUBLIC_URL=http://192.168.1.20:5173

# URL complète (prioritaire sur VITE_API_PORT) :
# VITE_API_BASE_URL=http://127.0.0.1:5001/api

# Revenir à l’ancien mode proxy /api (dépannage rare) :
# VITE_API_USE_PROXY=true
# VITE_PROXY_TARGET=http://127.0.0.1:5000

# VITE_API_BASE_URL=https://<api>.up.railway.app/api
