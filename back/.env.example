# connect_timeout (secondes) évite d'attendre ~10–15 s si MySQL est arrêté
# charset=utf8mb4 ensures correct French accents in MySQL (é, è, à, ç, …)
DATABASE_URL="mysql://root@127.0.0.1:3306/stokify?charset=utf8mb4&connect_timeout=5"
# Générer un secret : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# En production, un placeholder (your / change / secret) ou moins de 32 caractères refuse le démarrage.
JWT_SECRET="your_super_secret_key_here_min_32_chars"
JWT_EXPIRES_IN="7d"
PORT=5000
FRONTEND_URL="http://localhost:5173"
# URL publique HTTPS du backend (ex. ngrok) pour afficher le logo dans les e-mails Gmail
PUBLIC_API_URL=
# Ou URL directe du logo (prioritaire)
EMAIL_LOGO_URL=
AI_SERVICE_URL="http://localhost:8000"
# Clé partagée Node ↔ FastAPI (openssl rand -hex 32). Vide = dev local sans auth.
# La même valeur doit être présente dans l'environnement du processus ai-service.
AI_SERVICE_KEY=
AI_ENV=development
# Slots de calcul simultanés côté FastAPI (les autres requêtes, dont /health, restent servies).
AI_MAX_HEAVY=2
# Groq API (assistant STOKI / STELLA — https://console.groq.com)
GROQ_API_KEY=
GROQ_TIMEOUT_MS=15000
# Optionnel : forcer un modèle (défaut openai/gpt-oss-120b puis openai/gpt-oss-20b)
# GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Gmail SMTP (nodemailer — service: "gmail", auth via SMTP_USER / SMTP_PASS)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Stokify
# Délai relance client auto (15 | 30 | 60) — surcharge Societe.joursRelanceClient si défini
# RELANCE_CLIENT_JOURS=30
# DISABLE_RELANCES=1
NODE_ENV=production
# ex. /data/uploads, volume persistant
UPLOAD_ROOT=
