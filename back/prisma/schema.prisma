generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Societe {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  nom            String
  actif          Boolean         @default(true)
  adresse        String?
  ville          String?
  latitude       Float?
  longitude      Float?
  telephones     String?
  email          String?
  capital        Float?
  logo           String?
  smtpHost       String?
  smtpPort       Int?
  smtpUser       String?
  smtpPass       String?
  createdAt      DateTime        @default(now())
  depots         Depot[]
  articles       Article[]
  clients        Client[]
  fournisseurs   Fournisseur[]
  utilisateurs   Utilisateur[]
  ventes         Vente[]
  achats         Achat[]
  factures       Facture[]
  marques        Marque[]
  groupes        Groupe[]
  familles       Famille[]
  sousFamilles   SousFamille[]
  coutStockages     CoutStockage[]
  coutDepotMensuels CoutDepotMensuel[]
  coutEntries       CoutEntry[]
  deadStockSeuil    Int              @default(50000)
  /** Taux annuel de possession du stock dormant (%), utilisé pour le coût d'immobilisation. */
  tauxPossessionAnnuel Float         @default(2)
  seuilValidationMouvement Float     @default(1000)
  /** Délai (jours) avant relance client auto — typiquement 15, 30 ou 60 */
  joursRelanceClient Int             @default(30)
  alertesStock      AlerteStock[]
  auditLogs         AuditLog[]
  activityLogs      ActivityLog[]
  retoursFournisseur RetourFournisseur[]
  vehicules         Vehicule[]
  paniers           Panier[]
  commandesClient   CommandeClient[]
  wishlistItems     WishlistItem[]
  demandesClient    DemandeClient[]
}

model Depot {
  id             Int            @id @default(autoincrement())
  code           String
  libelle        String
  adresse        String?
  ville          String?
  region         String?
  capacite       Float?
  qteMin         Float?
  qteMax         Float?
  capaciteVolume Float?
  capacitePoids  Float?
  latitude       Float?
  longitude      Float?
  societe        Societe        @relation(fields: [societeId], references: [id])
  societeId      Int
  emplacements   Emplacement[]
  stocks         Stock[]
  mouvements     Mouvement[]
  mouvementsIn   Mouvement[]    @relation("mouvDest")
  inventaires    Inventaire[]
  ventes         Vente[]
  achats         Achat[]
  coutStockages      CoutStockage[]
  coutDepotMensuels  CoutDepotMensuel[]
  coutEntries        CoutEntry[]
  numerosSerie       NumeroSerie[]
  lots               Lot[]
  couchesFifo        CouchesFifo[]
  historiqueCMP      HistoriqueCMP[]
  alertesStock       AlerteStock[]
  anomaliesDetectees AnomalieDetectee[]
  /** ACTIF | INACTIF */
  statut             String            @default("ACTIF")
  storageRefrigere   Boolean           @default(false)
  storageChimique    Boolean           @default(false)
  storageInflammable Boolean           @default(false)
  storageFragile     Boolean           @default(false)

  @@unique([code, societeId])
}

model Emplacement {
  id                 Int               @id @default(autoincrement())
  code               String
  libelle            String
  categorie          String?
  barcode            String?
  niveaux            Int?
  zoneDangereuse     Boolean           @default(false)
  categorieAutorisee String?
  distanceQuai       Int               @default(50)
  capaciteSlots      Int?
  depot              Depot             @relation(fields: [depotId], references: [id])
  depotId            Int
  stocks             Stock[]
  lignesInventaire   LigneInventaire[]
  mouvementsOrigine  Mouvement[]       @relation("mouvEmplOrigine")
  mouvementsDest     Mouvement[]       @relation("mouvEmplDest")
  /** ACTIF | INACTIF */
  statut             String            @default("ACTIF")

  @@unique([code, depotId])
}

model Famille {
  id           Int          @id @default(autoincrement())
  code         String
  nom          String
  description  String?
  societe      Societe      @relation(fields: [societeId], references: [id])
  societeId    Int
  articles     Article[]
  sousFamilles SousFamille[]
  /** ACTIF | INACTIF */
  statut       String       @default("ACTIF")

  @@unique([code, societeId])
}

model SousFamille {
  id        Int       @id @default(autoincrement())
  code      String
  nom       String
  societe   Societe   @relation(fields: [societeId], references: [id])
  societeId Int
  famille   Famille   @relation(fields: [familleId], references: [id])
  familleId Int
  articles  Article[]
  /** ACTIF | INACTIF */
  statut    String    @default("ACTIF")

  @@unique([code, societeId])
}

model Article {
  id             Int               @id @default(autoincrement())
  code           String
  codeBarres     String?
  libelle        String
  description    String?
  /** URL publique de l’image (HTTPS recommandé) — saisie par l’admin */
  imageUrl       String?
  unite          String
  prixAchat      Float             @default(0)
  prixVente      Float             @default(0)
  stockMin       Int?
  stockMax       Int?
  /** Seuil d'alerte personnalisé (remplace stockMin pour les alertes si défini) */
  seuilAlerte    Float?
  /** Type de traçabilité : AUCUN | LOT | SERIE | LOT_SERIE */
  modeTracage    String            @default("AUCUN")
  /** true = génération auto à l'achat + décrément auto à la vente ; false = saisie manuelle via l'interface */
  tracageAuto    Boolean           @default(false)
  /** @deprecated conservé pour compatibilité descendante, ne plus utiliser dans le nouveau code — migrer vers modeTracage */
  modeGestion    String            @default("STANDARD")
  /** FIFO | FEFO | STANDARD — stratégie de sortie des lots */
  strategieSortie String           @default("FIFO")
  tauxTva         Float             @default(19)
  /** Taux de TVA en % : 19 | 13 | 7 | 0 (exonéré) */
  actif          Boolean           @default(true)
  /** ACTIF | ARCHIVE | BLOQUE */
  statut         String            @default("ACTIF")
  societe        Societe           @relation(fields: [societeId], references: [id])
  societeId      Int
  famille        Famille?          @relation(fields: [familleId], references: [id])
  familleId      Int?
  sousFamille    SousFamille?      @relation(fields: [sousFamilleId], references: [id])
  sousFamilleId  Int?
  marque         Marque?           @relation(fields: [marqueId], references: [id])
  marqueId       Int?
  groupe         Groupe?           @relation(fields: [groupeId], references: [id])
  groupeId       Int?
  fournisseur    Fournisseur?      @relation(fields: [fournisseurId], references: [id])
  fournisseurId  Int?
  stocks         Stock[]
  mouvements     Mouvement[]
  lignesAchat    LigneAchat[]
  lignesVente    LigneVente[]
  lots           Lot[]
  valorisations  Valorisation[]
  inventaires    LigneInventaire[]
  numerosSerie    NumeroSerie[]
  coutStockages   CoutStockage[]
  couchesFifo     CouchesFifo[]
  historiqueCMP   HistoriqueCMP[]
  temperatureMin    Float?
  temperatureMax    Float?
  fragile           Boolean           @default(false)
  dangereuxChimique Boolean           @default(false)
  poids             Float?
  volume            Float?
  alertesStock      AlerteStock[]
  anomaliesDetectees AnomalieDetectee[]
  lignesPanier      LignePanier[]
  lignesCommandeClient LigneCommandeClient[]
  wishlistItems     WishlistItem[]
  demandesClient    DemandeClient[]
  retoursFournisseur RetourFournisseur[]

  @@unique([code, societeId])
}

model Stock {
  id            Int          @id @default(autoincrement())
  article       Article      @relation(fields: [articleId], references: [id])
  articleId     Int
  depot         Depot        @relation(fields: [depotId], references: [id])
  depotId       Int
  emplacement   Emplacement? @relation(fields: [emplacementId], references: [id])
  emplacementId Int?
  quantite      Float        @default(0)
  quantiteMin   Float?
  quantiteMax   Float?
  qteReservee   Float        @default(0)
  coutStockage  Float?
  dateLastMvt   DateTime?
  /** ACTIF | ARCHIVE | BLOQUE */
  statut        String       @default("ACTIF")
  actif         Boolean      @default(true)

  @@unique([articleId, depotId, emplacementId])
}

model AlerteStock {
  id        Int       @id @default(autoincrement())
  article   Article   @relation(fields: [articleId], references: [id])
  articleId Int
  depot     Depot     @relation(fields: [depotId], references: [id])
  depotId   Int
  societe   Societe   @relation(fields: [societeId], references: [id])
  societeId Int
  type      String    // RUPTURE | CRITIQUE
  resolue   Boolean   @default(false)
  resolueAt DateTime?
  createdAt DateTime  @default(now())

  @@index([articleId, depotId, type, createdAt])
  @@index([societeId, resolue, createdAt])
}

model Mouvement {
  id                Int         @id @default(autoincrement())
  reference         String      @unique
  type              String
  article           Article     @relation(fields: [articleId], references: [id])
  articleId         Int
  depot             Depot       @relation(fields: [depotId], references: [id])
  depotId           Int
  depotDest         Depot?      @relation("mouvDest", fields: [depotDestId], references: [id])
  depotDestId       Int?
  emplacement       Emplacement? @relation("mouvEmplOrigine", fields: [emplacementId], references: [id])
  emplacementId     Int?
  emplacementDest   Emplacement? @relation("mouvEmplDest", fields: [emplacementDestId], references: [id])
  emplacementDestId Int?
  quantite          Float
  valeur        Float?
  lot           Lot?        @relation(fields: [lotId], references: [id])
  lotId         Int?
  /** JSON : détail multi-lots consommés [{ lotId, lotNumero, quantite, ... }] */
  lotsDetail    String?     @db.Text
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  utilisateurId Int
  commentaire   String?
  /** VALIDE | EN_ATTENTE_VALIDATION | REJETE */
  statut        String      @default("VALIDE")
  createdAt     DateTime    @default(now())
  retourFournisseur RetourFournisseur?
  anomaliesDetectees AnomalieDetectee[]
}

model AnomalieDetectee {
  id                 Int       @id @default(autoincrement())
  article            Article   @relation(fields: [articleId], references: [id])
  articleId          Int
  depot              Depot     @relation(fields: [depotId], references: [id])
  depotId            Int
  mouvement          Mouvement @relation(fields: [mouvementId], references: [id])
  mouvementId        Int
  score              Float
  raison             String
  quantiteObservee   Float?
  moyenneHabituelle  Float?
  dateDetection      DateTime  @default(now())
  dateResolution     DateTime?
  /** NON_RESOLU | CONFIRME | RESOLU */
  statut             String    @default("NON_RESOLU")
  /** NORMAL (faux positif) | CONFIRME (vrai positif) */
  feedback           String?
  modele             String?
  mlMeta             Json?

  @@index([statut, dateDetection])
  @@index([articleId, depotId])
  @@index([mouvementId, statut])
}

model Lot {
  id               Int               @id @default(autoincrement())
  numero           String
  article          Article           @relation(fields: [articleId], references: [id])
  articleId        Int
  depot            Depot             @relation(fields: [depotId], references: [id])
  depotId          Int
  dateFabrication  DateTime?
  dateExpiration   DateTime?
  quantiteInitiale Float
  quantiteRestante Float
  statut           String            @default("ACTIF")
  statutRappel            String?
  dateRappel              DateTime?
  /** Palier dernière alerte DLC email : "J30" | "J7" | null */
  derniereAlerteEnvoyee   String?
  achat            Achat?            @relation(fields: [achatId], references: [id])
  achatId          Int?
  mouvements       Mouvement[]
  lignesInventaire LigneInventaire[]
  numerosSerie     NumeroSerie[]
  couchesFifo      CouchesFifo[]
  retours          RetourFournisseur[]

  @@unique([articleId, numero, depotId])
}

model Fournisseur {
  id           Int       @id @default(autoincrement())
  code         String
  nom          String
  adresse      String?
  ville        String?
  pays         String?
  latitude     Float?
  longitude    Float?
  telephone    String?
  email        String?
  contact      String?
  tauxRemise   Float?
  delaiPayment Int?
  noteCredit   Float?
  actif        Boolean   @default(true)
  societe      Societe   @relation(fields: [societeId], references: [id])
  societeId    Int
  achats       Achat[]
  articles     Article[]
  retoursFournisseur RetourFournisseur[]

  @@unique([code, societeId])
}

model Client {
  id            Int      @id @default(autoincrement())
  code          String
  nom           String
  adresse       String?
  ville         String?
  pays          String?
  latitude      Float?
  longitude     Float?
  telephone     String?
  email         String?
  contact       String?
  plafondCredit Float?
  encours       Float    @default(0)
  tauxRemise    Float?
  modePaiement  String?
  actif         Boolean  @default(true)
  societe       Societe  @relation(fields: [societeId], references: [id])
  societeId     Int
  ventes        Vente[]
  factures      Facture[]
  relances      RelanceClient[]
  paniers       Panier[]
  commandesClient CommandeClient[]
  wishlistItems WishlistItem[]
  demandesClient DemandeClient[]
  utilisateurs  Utilisateur[]

  @@unique([code, societeId])
}

model Panier {
  id         Int             @id @default(autoincrement())
  clientId   Int
  societeId  Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  lignes     LignePanier[]

  client     Client   @relation(fields: [clientId], references: [id])
  societe    Societe  @relation(fields: [societeId], references: [id])

  @@unique([clientId, societeId])
}

model LignePanier {
  id         Int      @id @default(autoincrement())
  panierId   Int
  articleId  Int
  quantite   Decimal  @default(1) @db.Decimal(18, 3)
  createdAt  DateTime @default(now())

  panier     Panier   @relation(fields: [panierId], references: [id], onDelete: Cascade)
  article    Article  @relation(fields: [articleId], references: [id])

  @@unique([panierId, articleId])
}

model CommandeClient {
  id               Int                  @id @default(autoincrement())
  reference        String               @unique
  clientId         Int
  societeId        Int
  statut           StatutCommandeClient @default(EN_ATTENTE)
  montantHT        Decimal              @db.Decimal(18, 3)
  montantTTC       Decimal              @db.Decimal(18, 3)
  /** Adresse de livraison saisie au checkout */
  adresseLivraison String?              @db.Text
  /** Notes / instructions de livraison */
  notesLivraison   String?              @db.Text
  /** ESPECES | VIREMENT | CHEQUE | A_LA_LIVRAISON | AUTRE */
  modePaiement     String?
  /** Vente brouillon créée pour ADMIN/MAGASINIER (confirmation stock via confirmerVente) */
  venteId          Int?                 @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  lignes           LigneCommandeClient[]

  client      Client   @relation(fields: [clientId], references: [id])
  societe     Societe  @relation(fields: [societeId], references: [id])
  vente       Vente?   @relation(fields: [venteId], references: [id])
  demandesClient DemandeClient[]
}

model DemandeClient {
  id          Int      @id @default(autoincrement())
  societeId   Int
  clientId    Int
  articleId   Int?
  commandeId  Int?
  /** ARTICLE | COMMANDE */
  sujet       String
  /** OUVERTE | FERMEE */
  statut      String   @default("OUVERTE")
  nonLuEquipe Boolean  @default(true)
  nonLuClient Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  societe  Societe         @relation(fields: [societeId], references: [id], onDelete: Cascade)
  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  article  Article?        @relation(fields: [articleId], references: [id], onDelete: SetNull)
  commande CommandeClient? @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  messages MessageDemande[]

  @@index([societeId, nonLuEquipe])
  @@index([clientId, societeId])
}

model MessageDemande {
  id        Int      @id @default(autoincrement())
  demandeId Int
  auteurId  Int
  corps     String   @db.Text
  createdAt DateTime @default(now())

  demande DemandeClient @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  auteur  Utilisateur   @relation(fields: [auteurId], references: [id])

  @@index([demandeId, createdAt])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  clientId  Int
  societeId Int
  articleId Int
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([clientId, societeId, articleId])
  @@index([clientId, societeId])
}

model LigneCommandeClient {
  id           Int      @id @default(autoincrement())
  commandeId   Int
  articleId    Int
  quantite     Decimal  @db.Decimal(18, 3)
  prixUnitaire Decimal  @db.Decimal(18, 3)

  commande     CommandeClient @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  article      Article        @relation(fields: [articleId], references: [id])
}

enum StatutCommandeClient {
  EN_ATTENTE
  CONFIRMEE
  EN_PREPARATION
  EXPEDIEE
  LIVREE
  ANNULEE
}

model Achat {
  id                    Int               @id @default(autoincrement())
  reference             String            @unique
  fournisseur           Fournisseur       @relation(fields: [fournisseurId], references: [id])
  fournisseurId         Int
  societe               Societe           @relation(fields: [societeId], references: [id])
  societeId             Int
  depot                 Depot?            @relation(fields: [depotId], references: [id])
  depotId               Int?
  dateCommande          DateTime          @default(now())
  dateReception         DateTime?
  dateLivraisonPrevue   DateTime?
  dateLivraisonReelle   DateTime?
  retardJours           Int?
  /** BROUILLON | CONFIRME (legacy: COMMANDE, RECU, RECEPTIONNE, ANNULE) */
  statut                String            @default("BROUILLON")
  confirmedAt           DateTime?
  confirmedBy           Int?
  confirmateur          Utilisateur?      @relation("AchatConfirmateur", fields: [confirmedBy], references: [id])
  totalHT         Float             @default(0)
  totalTVA        Float             @default(0)
  totalTTC        Float             @default(0)
  remise          Float             @default(0)
  montantRegle    Float             @default(0)
  statutPaiement  String            @default("NON_REGLE")
  lignes          LigneAchat[]
  reglements      ReglementAchat[]
  lots            Lot[]
  retours         RetourFournisseur[]
}

model LigneAchat {
  id           Int     @id @default(autoincrement())
  achat        Achat   @relation(fields: [achatId], references: [id])
  achatId      Int
  article      Article @relation(fields: [articleId], references: [id])
  articleId    Int
  quantite     Float
  quantiteRecue Float  @default(0)
  prixUnit     Float
  remise       Float   @default(0)
  totalHT      Float
  tauxTva      Float   @default(19)
  montantTva   Float   @default(0)
  dateExpiration DateTime?
}

model Vente {
  id              Int          @id @default(autoincrement())
  reference       String       @unique
  client          Client       @relation(fields: [clientId], references: [id])
  clientId        Int
  societe         Societe      @relation(fields: [societeId], references: [id])
  societeId       Int
  depot           Depot?       @relation(fields: [depotId], references: [id])
  depotId         Int?
  dateVente       DateTime     @default(now())
  dateLivraison   DateTime?
  /** BROUILLON | CONFIRME (legacy: VALIDE, LIVRE, EN_ATTENTE, ANNULE, RETOUR) */
  statut          String       @default("BROUILLON")
  livree          Boolean      @default(false)
  typeVente       String       @default("VENTE")
  confirmedAt     DateTime?
  confirmedBy     Int?
  confirmateur    Utilisateur? @relation("VenteConfirmateur", fields: [confirmedBy], references: [id])
  totalHT         Float        @default(0)
  totalTVA        Float        @default(0)
  totalTTC        Float        @default(0)
  remise          Float        @default(0)
  montantRegle    Float        @default(0)
  statutPaiement  String       @default("NON_REGLE")
  modePaiement    String?
  venteOrigineId  Int?
  venteOrigine    Vente?       @relation("VenteAvoir", fields: [venteOrigineId], references: [id])
  avoirs          Vente[]      @relation("VenteAvoir")
  lignes          LigneVente[]
  reglements      Reglement[]
  facture         Facture?
  relances        RelanceClient[]
  commandeClient  CommandeClient?
}

model LigneVente {
  id           Int     @id @default(autoincrement())
  vente        Vente   @relation(fields: [venteId], references: [id])
  venteId      Int
  article      Article @relation(fields: [articleId], references: [id])
  articleId    Int
  quantite     Float
  prixUnit     Float
  remise       Float   @default(0)
  tauxTva      Float   @default(19)
  montantTva   Float   @default(0)
  totalHT      Float
  lotsConsumed       String? @db.Text
  /** Snapshot de Article.strategieSortie au moment de la confirmation */
  strategieAppliquee String?
  /** @deprecated alias — prefer strategieAppliquee */
  strategie          String?
}

model Facture {
  id                 Int       @id @default(autoincrement())
  numero             String    @unique
  vente              Vente     @relation(fields: [venteId], references: [id])
  venteId            Int       @unique
  client             Client    @relation(fields: [clientId], references: [id])
  clientId           Int
  societe            Societe   @relation(fields: [societeId], references: [id])
  societeId          Int
  montantHT          Float
  tva                Float
  montantTTC         Float
  statut             String    @default("EMISE")
  dateEcheance       DateTime?
  factureEmailSentAt DateTime?
  factureEmailSentTo String?
  createdAt          DateTime  @default(now())
}

model RelanceClient {
  id        Int      @id @default(autoincrement())
  client    Client   @relation(fields: [clientId], references: [id])
  clientId  Int
  vente     Vente?   @relation(fields: [venteId], references: [id])
  venteId   Int?
  type      String   @default("AUTO")
  sentAt    DateTime @default(now())
  email     String?
}

model Inventaire {
  id                 Int               @id @default(autoincrement())
  reference          String            @unique
  date               DateTime          @default(now())
  statut             String            @default("EN_COURS")
  typeInventaire     String            @default("complet")
  modeAveugle        Boolean           @default(false)
  zoneIds            String?           @db.LongText
  depot              Depot             @relation(fields: [depotId], references: [id])
  depotId            Int
  lignes             LigneInventaire[]
}

model LigneInventaire {
  id           Int           @id @default(autoincrement())
  inventaire   Inventaire    @relation(fields: [inventaireId], references: [id])
  inventaireId Int
  article      Article       @relation(fields: [articleId], references: [id])
  articleId    Int
  lot          Lot?          @relation(fields: [lotId], references: [id])
  lotId        Int?
  emplacement  Emplacement?  @relation(fields: [emplacementId], references: [id])
  emplacementId Int?
  qteTheorique Float
  qteReelle    Float?
  ecart        Float?
  valeurEcart  Decimal?      @db.Decimal(18, 4)
  /** JSON des lots consommés/ajustés (écarts négatifs) ou warning si non identifiable */
  lotsAjustes        String?       @db.Text
  valide             Boolean       @default(false)
  recomptageDemande  Boolean       @default(false)
}

model Valorisation {
  id        Int      @id @default(autoincrement())
  article   Article  @relation(fields: [articleId], references: [id])
  articleId Int
  methode   String
  valeurUnit Float
  date      DateTime @default(now())
}

model Reglement {
  id                   Int       @id @default(autoincrement())
  vente                Vente     @relation(fields: [venteId], references: [id])
  venteId              Int
  montant              Float
  /** ENCAISSEMENT (paiement reçu) | REMBOURSEMENT (à rendre au client suite à un avoir) */
  type                 String    @default("ENCAISSEMENT")
  datePayment          DateTime  @default(now())
  reference            String?
  mode                 String
  statut               String    @default("EN_ATTENTE")
  commentaire          String?
  numeroCheque         String?
  banque               String?
  dateEcheance         DateTime?
  referenceVirement    String?
  dateValeur           DateTime?
  referenceTransaction String?
  referenceEffet       String?
  descriptionAutre     String?
  /** Justificatif (PDF/JPG) — chemin /uploads/reglements/... */
  pieceJointeUrl       String?
}

model ReglementAchat {
  id                   Int       @id @default(autoincrement())
  achat                Achat     @relation(fields: [achatId], references: [id])
  achatId              Int
  montant              Float
  datePayment          DateTime  @default(now())
  reference            String?
  mode                 String
  statut               String    @default("EN_ATTENTE")
  commentaire          String?
  numeroCheque         String?
  banque               String?
  dateEcheance         DateTime?
  referenceVirement    String?
  dateValeur           DateTime?
  referenceTransaction String?
  referenceEffet       String?
  descriptionAutre     String?
  /** Justificatif (PDF/JPG) — chemin /uploads/reglements/... */
  pieceJointeUrl       String?
}

model Marque {
  id        Int       @id @default(autoincrement())
  code      String
  nom       String
  imageUrl  String?
  societe   Societe   @relation(fields: [societeId], references: [id])
  societeId Int
  articles  Article[]
  /** ACTIF | INACTIF */
  statut    String    @default("ACTIF")

  @@unique([code, societeId])
}

model Groupe {
  id        Int       @id @default(autoincrement())
  code      String
  nom       String
  description String?
  societe   Societe   @relation(fields: [societeId], references: [id])
  societeId Int
  articles  Article[]

  @@unique([code, societeId])
}

model NumeroSerie {
  id        Int      @id @default(autoincrement())
  numero    String   @unique
  article   Article  @relation(fields: [articleId], references: [id])
  articleId Int
  societeId Int
  statut    String   @default("DISPONIBLE")
  depot     Depot?   @relation(fields: [depotId], references: [id])
  depotId   Int?
  lot       Lot?     @relation(fields: [lotId], references: [id])
  lotId     Int?
  notes     String?
  createdAt DateTime @default(now())
}

model CouchesFifo {
  id               Int      @id @default(autoincrement())
  article          Article  @relation(fields: [articleId], references: [id])
  articleId        Int
  depot            Depot    @relation(fields: [depotId], references: [id])
  depotId          Int
  lot              Lot?     @relation(fields: [lotId], references: [id])
  lotId            Int?
  quantiteInitiale Float
  quantiteRestante Float
  prixUnitaire     Float
  dateEntree       DateTime @default(now())
  orderIndex       Int
  achatId          Int?
}

model HistoriqueCMP {
  id             Int      @id @default(autoincrement())
  article        Article  @relation(fields: [articleId], references: [id])
  articleId      Int
  depot          Depot    @relation(fields: [depotId], references: [id])
  depotId        Int
  ancienCMP      Float
  nouveauCMP     Float
  quantiteEntree Float
  prixEntree     Float
  dateCalcul     DateTime @default(now())
}

model CoutDepotMensuel {
  id              Int      @id @default(autoincrement())
  depot           Depot    @relation(fields: [depotId], references: [id])
  depotId         Int
  societe         Societe  @relation(fields: [societeId], references: [id])
  societeId       Int
  periode         String
  coutLoyer       Float    @default(0)
  coutPersonnel   Float    @default(0)
  coutEnergie     Float    @default(0)
  coutManutention Float    @default(0)
  autresFrais     Float    @default(0)
  total           Float    @default(0)
  commentaire     String?
  createdAt       DateTime @default(now())

  @@unique([depotId, periode])
}

model CoutStockage {
  id             Int       @id @default(autoincrement())
  societe        Societe   @relation(fields: [societeId], references: [id])
  societeId      Int
  article        Article   @relation(fields: [articleId], references: [id])
  articleId      Int
  depot          Depot     @relation(fields: [depotId], references: [id])
  depotId        Int
  coutUnitaire   Float
  devise         String?   @default("TND")
  periodeDebut   DateTime
  periodeFin     DateTime?
  commentaire    String?
  createdAt      DateTime  @default(now())
}

model CoutEntry {
  id          Int          @id @default(autoincrement())
  nom         String
  description String?
  montant     Float
  categorie   String? // "STOCKAGE" | "LOGISTIQUE" | "MANUTENTION" | "AUTRE"
  periode     String
  depot       Depot        @relation(fields: [depotId], references: [id])
  depotId     Int
  societe     Societe      @relation(fields: [societeId], references: [id])
  societeId   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   Int?
  utilisateur Utilisateur? @relation(fields: [createdBy], references: [id])

  @@index([depotId, periode, societeId])
}

model Utilisateur {
  id          Int         @id @default(autoincrement())
  nom         String
  prenom      String
  email       String      @unique
  motDePasse  String
  role        String      @default("MAGASINIER")
  actif       Boolean     @default(true)
  noteDesactivation String?
  dateDesactivation DateTime?
  profileCompleted  Boolean   @default(false) @map("profilComplete")
  mustChangePassword Boolean  @default(false) @map("doitChangerMdp")
  avatar            String?   @map("photoUrl") @db.Text
  telephone         String?
  poste             String?   @map("posteOccupe")
  bio               String?   @db.Text
  theme             String?   @default("dark")
  lastLoginAt       DateTime?
  loginCount        Int       @default(0)
  tentativesEchouees Int      @default(0)
  verrouilleJusqua  DateTime?
  permissions       Json?     @default("{}")
  createdAt         DateTime  @default(now())
  dateProfilCompletee DateTime?
  societe     Societe     @relation(fields: [societeId], references: [id])
  societeId   Int
  clientId    Int?
  client      Client?     @relation(fields: [clientId], references: [id])
  /** ACTIF | EN_ATTENTE_VALIDATION | EN_ATTENTE_RATTACHEMENT | REJETE */
  statutCompte String     @default("ACTIF")
  mouvements  Mouvement[]
  audits      Audit[]
  achatsConfirmes Achat[] @relation("AchatConfirmateur")
  ventesConfirmes Vente[] @relation("VenteConfirmateur")
  auditLogs       AuditLog[]
  permissionOverrides PermissionOverride[]
  activityLogs    ActivityLog[]
  coutEntries     CoutEntry[]
  messagesDemande MessageDemande[]
}

model PermissionOverride {
  id            Int         @id @default(autoincrement())
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId Int
  module        String
  niveau        String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([utilisateurId, module])
}

model AuditLog {
  id         Int         @id @default(autoincrement())
  entityType String
  entityId   Int
  action     String
  oldValue   String?     @db.Text
  newValue   String?     @db.Text
  utilisateur Utilisateur @relation(fields: [userId], references: [id])
  userId     Int
  societe    Societe     @relation(fields: [societeId], references: [id])
  societeId  Int
  createdAt  DateTime    @default(now())

  @@index([societeId, entityType, createdAt])
}

enum MotifRetour {
  NON_CONFORME
  ABIME
  ERREUR_REFERENCE
  DATE_PEREMPTION_COURTE
  SURPLUS
  QUALITE_INSUFFISANTE
  AUTRE
}

enum StatutRetour {
  EN_ATTENTE
  ACCEPTE
  REFUSE
  REMPLACEMENT_DEMANDE
  AVOIR_EMIS
}

model RetourFournisseur {
  id                 Int          @id @default(autoincrement())
  reference          String       @unique
  achat              Achat?       @relation(fields: [achatId], references: [id])
  achatId            Int?
  lot                Lot?         @relation(fields: [lotId], references: [id])
  lotId              Int?
  fournisseur        Fournisseur  @relation(fields: [fournisseurId], references: [id])
  fournisseurId      Int
  article            Article?     @relation(fields: [articleId], references: [id])
  articleId          Int?
  quantiteRetournee  Float?
  quantiteAchetee    Float?
  motif              MotifRetour  @default(AUTRE)
  statut             StatutRetour @default(EN_ATTENTE)
  avoirGenere        Boolean      @default(false)
  montantAvoir       Float?
  notes              String?      @db.Text
  mouvement          Mouvement?   @relation(fields: [mouvementId], references: [id])
  mouvementId        Int?         @unique
  societe            Societe      @relation(fields: [societeId], references: [id])
  societeId          Int
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Vehicule {
  id              Int      @id @default(autoincrement())
  societeId       Int
  societe         Societe  @relation(fields: [societeId], references: [id])
  nom             String
  immatriculation String?
  capacitePoids   Float
  capaciteVolume  Float
  actif           Boolean  @default(true)
}

model Audit {
  id             Int         @id @default(autoincrement())
  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id])
  utilisateurId  Int
  action         String
  module         String
  entite         String?
  entiteId       String?
  description    String?     @db.Text
  ip             String?
  societeId      Int?
  ancienneValeur String?
  nouvelleValeur String?
  createdAt      DateTime    @default(now())
}

model ActivityLog {
  id          Int          @id @default(autoincrement())
  userId      Int
  user        Utilisateur  @relation(fields: [userId], references: [id])
  action      String
  module      String
  entity      String?
  entityId    Int?
  entityLabel String?
  details     Json?
  ipAddress   String?
  userAgent   String?      @db.Text
  status      String       @default("SUCCESS")
  errorMsg    String?      @db.Text
  societeId   Int?
  societe     Societe?     @relation(fields: [societeId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@index([societeId])
}

model ExpiryPrediction {
  id               Int       @id @default(autoincrement())
  societeId        Int
  lotId            Int
  asOf             DateTime
  joursRestants    Int
  qteRestante      Float
  pWaste           Float
  qteP50           Float
  qteP90           Float
  modelVersion     String
  features         Json
  observedWasteQty Float?
  observedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@unique([lotId, asOf])
  @@index([societeId, observedAt])
}
